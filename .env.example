# Supabase Configuration (Client-safe public keys only)
# Copy this file to .env.local and fill in the values from your Supabase Project Settings -> API.
# NEVER put your service_role key in this file or anywhere in the frontend.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
